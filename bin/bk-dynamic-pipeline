#!/usr/bin/env bash
# bk-dynamic-pipeline — CLI wrapper for Buildkite Dynamic Pipeline DAG Generator
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
REPO_ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

exec node "${REPO_ROOT}/tools/buildkite-dynamic-pipeline.js" "$@"
