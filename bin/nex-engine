#!/usr/bin/env bash
# nex-engine — CLI wrapper for Nex.ai-style Playbook Engine & Team Knowledge Graph
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
REPO_ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

exec node "${REPO_ROOT}/tools/nex-playbook-engine.js" "$@"
