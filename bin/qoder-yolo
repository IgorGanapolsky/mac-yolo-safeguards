#!/usr/bin/env bash
# qoder-yolo — CLI launcher for Qoder Autonomous Agent Harness & Multi-Model Routing
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
REPO_ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

exec node "${REPO_ROOT}/tools/qoder-yolo-wrapper.js" "$@"
