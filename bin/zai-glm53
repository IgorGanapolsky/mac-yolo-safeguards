#!/usr/bin/env node
'use strict';

const path = require('path');
const { spawnSync } = require('child_process');

const ROOT = path.resolve(__dirname, '..');
const FLEET = path.join(ROOT, 'tools', 'zai-glm53-fleet.js');

function help() {
  process.stdout.write(`
GLM-5.3 fleet — Coding Plan first, $10/mo metered API cap

Usage:
  zai-glm53 doctor [--json]
  zai-glm53 install [--json]
  zai-glm53 probe [--json]
  zai-glm53 probe-gateway [--json]
  zai-glm53 route "<task>" [--json]
  zai-glm53 budget [--json]
`);
}

function main() {
  const argv = process.argv.slice(2);
  if (!argv.length || argv.includes('-h') || argv.includes('--help')) {
    help();
    return;
  }
  const res = spawnSync(process.execPath, [FLEET, ...argv], { stdio: 'inherit' });
  process.exit(res.status === null ? 1 : res.status);
}

main();
