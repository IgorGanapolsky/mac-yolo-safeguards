{
  "name": "hermes-control-plane",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:cloudflare": "HERMES_DEPLOY_TARGET=cloudflare WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "test:cloudflare-config": "node --test ../../tests/test-hermes-cloudflare-deploy-config.js",
    "test:cloudflare-worker": "npm run build:cloudflare && node tests/cloudflare-worker-smoke.mjs",
    "test:revenue-anomaly-watchdog": "npm run build:cloudflare && node tests/revenue-anomaly-watchdog-smoke.mjs",
    "test:e2e:machine": "npm run build:cloudflare && node tests/dashboard-machine-routing-e2e.mjs",
    "test:e2e:machine:nobuild": "node tests/dashboard-machine-routing-e2e.mjs",
    "test:e2e:prod-copy": "node tests/prod-dashboard-copy-smoke.mjs",
    "test:e2e:browser": "npm run build:cloudflare && playwright test",
    "test:e2e": "npm run build:cloudflare && node tests/cloudflare-worker-smoke.mjs && PLAYWRIGHT_E2E=${PLAYWRIGHT_E2E:-0} node tests/dashboard-machine-routing-e2e.mjs",
    "test:security": "node scripts/security-audit.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "cloudflare:validate-production": "node -e \"import('./build/cloudflare-target.mjs').then(({ assertProductionCloudflareEnvironment }) => assertProductionCloudflareEnvironment())\"",
    "predeploy:cloudflare": "npm run cloudflare:validate-production && npm run build:cloudflare && wrangler d1 export DB --remote --output=.wrangler/backups/pre-deploy-$(date -u +%Y%m%dT%H%M%SZ).sql --config dist/server/wrangler.json",
    "deploy:cloudflare": "npm run cloudflare:validate-production && npm run build:cloudflare && wrangler d1 migrations apply DB --remote --config dist/server/wrangler.json && wrangler deploy --config dist/server/wrangler.json",
    "deploy:cloudflare:locked": "bash ../../scripts/deploy-cloudflare-with-lock.sh",
    "rollback:status": "node ../../tools/hermes-control-plane-rollback.js status",
    "rollback:list": "node ../../tools/hermes-control-plane-rollback.js list",
    "rollback:prev": "node ../../tools/hermes-control-plane-rollback.js prev",
    "rollback:prev:go": "node ../../tools/hermes-control-plane-rollback.js prev --execute -y",
    "rollback:cloudflare": "wrangler rollback --config dist/server/wrangler.json",
    "test:unit": "vitest run --coverage"
  },
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "@scure/base": "^2.3.0",
    "drizzle-orm": "0.45.2",
    "next": "16.3.0",
    "postcss": "8.5.26",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.3",
    "@cloudflare/workers-types": "^5.20260810.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "playwright": "^1.55.1",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "undici": "^7.29.0",
    "vinext": "0.2.1",
    "vite": "8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "postcss": "8.5.26",
    "sharp": "0.35.3",
    "brace-expansion": "5.0.9",
    "minimatch": "10.2.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8"
  },
  "type": "module"
}
