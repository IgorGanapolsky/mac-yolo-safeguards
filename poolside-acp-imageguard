#!/usr/bin/env node
'use strict';
/*
 * poolside-acp-imageguard — an ACP proxy that sits between pool's client (the TUI)
 * and the real `pool acp` agent server, so that pasting a screenshot cannot brick a
 * session.
 *
 * THE BUG THIS EXISTS FOR (verified 2026-07-30, pool 1.0.14):
 *   `pool acp` answers `initialize` with
 *       "promptCapabilities": { "image": true }
 *   ...but the only models it serves are poolside/laguna-s-2.1 and
 *   poolside/laguna-xs-2.1, and BOTH are text-in/text-out with no vision. So the TUI
 *   believes images are supported and happily accepts a pasted screenshot, the
 *   request reaches inference.poolside.ai, and comes back:
 *       400 Bad Request: This model does not support multimodal
 *                        (image/video/audio) inputs.
 *
 *   That alone would be a papercut. What makes it fatal is that pool replays the
 *   whole conversation on every turn, so the offending image block stays in history
 *   forever: EVERY subsequent prompt — plain text, "continue", anything — dies with
 *   the same 400. The session is permanently unusable and its context is stranded.
 *   Observed in session 019faf19-c445-75ef-9c36-8f4d53f9626c: an image went in at
 *   2026-07-29T16:40:09, and the session was still returning that same 400 at
 *   2026-07-30T10:39:42 — 18 hours and 48 failed turns later.
 *
 * WHAT THIS DOES — two independent layers, because one of them is a request and the
 * other is a guarantee:
 *   1. Tells the truth on the way out. Rewrites the `initialize` RESULT so
 *      promptCapabilities.image (and .audio) are false. A well-behaved client then
 *      declines the paste itself, which is the nicest possible failure: it happens
 *      in the UI, before anything is committed to history.
 *   2. Enforces it on the way in. Any image/audio block that still arrives in a
 *      `session/prompt` is replaced with text BEFORE it can reach the model. This
 *      layer is what actually makes the guarantee, because layer 1 depends on a
 *      client we do not control honouring a capability flag.
 *
 * The replacement text is not a tombstone. By default the image is transcribed by a
 * vision model on the Hermes gateway (:4010) and the DESCRIPTION is injected as a
 * text block, so a pasted screenshot still carries its information into a text-only
 * session. Only when no vision route answers do we fall back to a plain note saying
 * the image was dropped and why.
 *
 * Transcription deliberately happens OUT OF BAND: a separate one-shot call whose
 * result is text. The pool session itself never holds an image, so this cannot drag
 * the session onto a small-context vision model.
 *
 * Wire protocol: ACP is newline-delimited JSON-RPC 2.0 over stdio (verified against
 * pool 1.0.14, not assumed). Anything this proxy does not understand — unknown
 * methods, notifications, non-JSON lines — is forwarded byte-for-byte. A guard that
 * mangles traffic it failed to parse would be worse than the bug it fixes.
 *
 * Config (env):
 *   POOLSIDE_IMAGE_GUARD=auto|describe|strip|off   default auto
 *       auto      = describe when a vision route answers, else strip
 *       describe  = describe, and still strip (never fail the turn) if that fails
 *       strip     = never call out to the network; always replace with a note
 *       off       = disable the proxy entirely (pure passthrough, bug and all)
 *   POOLSIDE_IMAGE_GUARD_URL     gateway base, default http://127.0.0.1:4010/v1
 *   POOLSIDE_IMAGE_GUARD_MODELS  comma-separated vision fallback chain
 *   POOLSIDE_IMAGE_GUARD_TIMEOUT ms per vision attempt, default 45000
 *   POOLSIDE_ACP_COMMAND         underlying agent server, default `pool`
 *
 * Subcommands:
 *   --install [--path P]  add/refresh the agent_servers entry in settings.yaml
 *   --uninstall           remove that entry
 *   --selftest            run the transform offline (no network, no pool)
 *   --doctor [--json]     report guard mode, gateway reachability, install state
 */

const { spawn } = require('child_process');
const fs = require('fs');
const os = require('os');
const path = require('path');
const readline = require('readline');

const AGENT_SERVER_NAME = 'HermesImageGuard';
const SETTINGS = process.env.POOLSIDE_SETTINGS ||
  path.join(os.homedir(), '.config', 'poolside', 'settings.yaml');

const MODE = (process.env.POOLSIDE_IMAGE_GUARD || 'auto').toLowerCase();
const KNOWN_MODES = ['auto', 'describe', 'strip', 'off'];
const GATEWAY = (process.env.POOLSIDE_IMAGE_GUARD_URL || 'http://127.0.0.1:4010/v1')
  .replace(/\/+$/, '');
// Ordered by "most likely to actually answer with a useful description". Every entry
// is a route the fleet gateway already serves; a missing one just falls through.
const VISION_MODELS = (process.env.POOLSIDE_IMAGE_GUARD_MODELS ||
  'glm-vision,vision-gemini,vision-free,vision-local')
  .split(',').map((s) => s.trim()).filter(Boolean);
const TIMEOUT_MS = Number(process.env.POOLSIDE_IMAGE_GUARD_TIMEOUT || 45000);

const DESCRIBE_PROMPT =
  'You are transcribing an image for a CODING AGENT that cannot see images. ' +
  'Describe everything that could matter to a developer: exact visible text ' +
  '(error messages, logs, stack traces, code, labels, URLs, numbers) quoted ' +
  'verbatim, the UI layout and state, and anything that looks wrong. Be complete ' +
  'and literal. Do not speculate about intent and do not offer advice.';

function isImageBlock(b) {
  return b && typeof b === 'object' && b.type === 'image' && typeof b.data === 'string';
}
function isAudioBlock(b) {
  return b && typeof b === 'object' && b.type === 'audio' && typeof b.data === 'string';
}

/* ---------------------------------------------------------------- transcription */

async function describeImage(block) {
  const mime = block.mimeType || 'image/png';
  const dataUrl = `data:${mime};base64,${block.data}`;
  let lastErr = 'no vision route configured';

  for (const model of VISION_MODELS) {
    const ctl = new AbortController();
    const timer = setTimeout(() => ctl.abort(), TIMEOUT_MS);
    try {
      const res = await fetch(`${GATEWAY}/chat/completions`, {
        method: 'POST',
        signal: ctl.signal,
        headers: {
          'content-type': 'application/json',
          // The gateway fronts the fleet's own keys; this bearer is only a
          // placeholder so the OpenAI client shape is satisfied.
          authorization: `Bearer ${process.env.POOLSIDE_IMAGE_GUARD_KEY || 'sk-hermes-local'}`,
        },
        body: JSON.stringify({
          model,
          messages: [{
            role: 'user',
            content: [
              { type: 'text', text: DESCRIBE_PROMPT },
              { type: 'image_url', image_url: { url: dataUrl } },
            ],
          }],
        }),
      });
      if (!res.ok) { lastErr = `${model}: HTTP ${res.status}`; continue; }
      const body = await res.json();
      const text = body?.choices?.[0]?.message?.content;
      if (typeof text === 'string' && text.trim()) {
        return { text: text.trim(), model };
      }
      lastErr = `${model}: empty completion`;
    } catch (e) {
      lastErr = `${model}: ${e && e.name === 'AbortError' ? `timeout after ${TIMEOUT_MS}ms` : String(e && e.message || e)}`;
    } finally {
      clearTimeout(timer);
    }
  }
  return { text: null, error: lastErr };
}

function strippedNote(kind, mime, reason) {
  return `[${kind} attachment removed by poolside-acp-imageguard — this model ` +
    `(poolside/laguna-*) has no ${kind === 'Image' ? 'vision' : 'audio'} support, and ` +
    `sending it would fail this turn AND every later turn in this session with ` +
    `"400 This model does not support multimodal inputs". ` +
    `Type: ${mime || 'unknown'}. Transcription unavailable: ${reason}. ` +
    `Tell the user you could not see the attachment and ask them to paste the ` +
    `relevant text, or re-run with POOLSIDE_YOLO_LANE=gateway on a vision model.]`;
}

function describedNote(kind, model, text) {
  return `[${kind} attachment auto-transcribed by poolside-acp-imageguard via ` +
    `${model} — the coding model itself cannot see images, so this text IS the ` +
    `attachment. Treat quoted strings as verbatim from the ${kind.toLowerCase()}.]\n\n${text}`;
}

/* ------------------------------------------------------------------- transform */

// Returns { prompt, changed, notes[] }.
async function transformPrompt(prompt) {
  if (!Array.isArray(prompt)) return { prompt, changed: false, notes: [] };
  const out = [];
  const notes = [];
  let changed = false;

  for (const block of prompt) {
    const image = isImageBlock(block);
    const audio = isAudioBlock(block);
    if (!image && !audio) { out.push(block); continue; }

    changed = true;
    const kind = image ? 'Image' : 'Audio';
    const bytes = Math.round(block.data.length * 3 / 4);

    // Audio has no transcription route on the fleet, so it is always a note.
    if (audio || MODE === 'strip') {
      const why = audio ? 'no audio transcription route' : 'guard mode=strip';
      out.push({ type: 'text', text: strippedNote(kind, block.mimeType, why) });
      notes.push(`${kind} (${bytes}B) -> note (${why})`);
      continue;
    }

    const { text, model, error } = await describeImage(block);
    if (text) {
      out.push({ type: 'text', text: describedNote(kind, model, text) });
      notes.push(`${kind} (${bytes}B) -> ${text.length} chars via ${model}`);
    } else {
      out.push({ type: 'text', text: strippedNote(kind, block.mimeType, error) });
      notes.push(`${kind} (${bytes}B) -> note (${error})`);
    }
  }
  return { prompt: out, changed, notes };
}

/* ----------------------------------------------------------------------- proxy */

function log(msg) { process.stderr.write(`poolside-acp-imageguard: ${msg}\n`); }

function runProxy(argv) {
  const cmd = process.env.POOLSIDE_ACP_COMMAND || 'pool';
  const args = ['acp', ...argv];
  const child = spawn(cmd, args, { stdio: ['pipe', 'pipe', 'inherit'] });

  child.on('error', (e) => {
    log(`failed to start '${cmd} acp': ${e.message}`);
    process.exit(127);
  });
  child.on('exit', (code, signal) => {
    process.exit(signal ? 128 + os.constants.signals[signal] : (code ?? 0));
  });

  // id of the initialize request, so we rewrite only ITS result and not some other
  // response that happens to carry an agentCapabilities-shaped object.
  let initializeId = null;

  // Client -> agent. Transforming a prompt needs an await, and ACP responses are
  // correlated by id, so we must not let a later message overtake an earlier one
  // while its images are being transcribed. A single promise chain preserves order.
  let chain = Promise.resolve();
  const toAgent = readline.createInterface({ input: process.stdin, crlfDelay: Infinity });

  toAgent.on('line', (line) => {
    chain = chain.then(async () => {
      if (!line.trim()) { child.stdin.write(line + '\n'); return; }
      let msg;
      try { msg = JSON.parse(line); } catch { child.stdin.write(line + '\n'); return; }

      if (msg && msg.method === 'initialize' && msg.id !== undefined) {
        initializeId = msg.id;
      }

      if (msg && msg.method === 'session/prompt' && msg.params && Array.isArray(msg.params.prompt)) {
        try {
          const { prompt, changed, notes } = await transformPrompt(msg.params.prompt);
          if (changed) {
            msg.params.prompt = prompt;
            for (const n of notes) log(n);
            child.stdin.write(JSON.stringify(msg) + '\n');
            return;
          }
        } catch (e) {
          // Never drop a turn because the guard itself failed. Forward the original
          // and let pool answer; a 400 is bad, a silently swallowed prompt is worse.
          log(`transform failed, forwarding unchanged: ${e && e.message || e}`);
        }
      }
      child.stdin.write(line + '\n');
    });
  });
  toAgent.on('close', () => { chain.then(() => child.stdin.end()); });

  // Agent -> client: correct the capability lie, pass everything else through.
  const toClient = readline.createInterface({ input: child.stdout, crlfDelay: Infinity });
  toClient.on('line', (line) => {
    if (!line.trim()) { process.stdout.write(line + '\n'); return; }
    let msg;
    try { msg = JSON.parse(line); } catch { process.stdout.write(line + '\n'); return; }

    const caps = msg?.result?.agentCapabilities?.promptCapabilities;
    if (initializeId !== null && msg.id === initializeId && caps && typeof caps === 'object') {
      // Layers 1 and 2 pull in opposite directions, and layer 2 is the one that makes
      // the safety guarantee. If we advertise image:false, a client that honours it
      // refuses the paste in its UI — which is a NICE failure when we have nothing
      // better to offer, but a REGRESSION when we do: it would block a screenshot we
      // are perfectly able to transcribe, and the user loses a working feature to
      // protect them from a bug we already neutralised.
      //
      // So the advertisement follows capability, not fear:
      //   can transcribe  -> leave pool's value alone; let the paste through and
      //                      convert it to text on the way in (layer 2).
      //   cannot          -> say false, so the client declines it up front.
      // Either way no image ever reaches the model, because layer 2 is unconditional.
      const canTranscribe = MODE === 'auto' || MODE === 'describe';
      if (canTranscribe) {
        log('initialize: leaving promptCapabilities.image as-is — images are accepted ' +
            'and transcribed to text before they reach the model');
      } else {
        const had = caps.image === true || caps.audio === true;
        caps.image = false;
        caps.audio = false;
        if (had) {
          log(`corrected initialize: promptCapabilities.image/audio -> false ` +
              `(guard mode=${MODE} cannot transcribe, and pool advertises image ` +
              `support its Laguna models do not have)`);
        }
      }
      process.stdout.write(JSON.stringify(msg) + '\n');
      return;
    }
    process.stdout.write(line + '\n');
  });
}

/* -------------------------------------------------------------------- settings */

// settings.yaml is small and hand-written; a full YAML parser is a dependency we do
// not want in a stdio hot path. We only ever add/remove one block under
// `agent_servers:` and refuse to guess if the file looks unfamiliar.
function readSettings() {
  try { return fs.readFileSync(SETTINGS, 'utf8'); } catch { return null; }
}

function installed(text) {
  return text !== null && new RegExp(`^\\s+${AGENT_SERVER_NAME}:`, 'm').test(text);
}

function selfPath() { return fs.realpathSync(process.argv[1]); }

function install() {
  let text = readSettings();
  if (text === null) {
    fs.mkdirSync(path.dirname(SETTINGS), { recursive: true });
    text = '';
  }
  const me = selfPath();
  const block =
    `    ${AGENT_SERVER_NAME}:\n` +
    `        type: custom\n` +
    `        command: ${me}\n`;

  if (installed(text)) {
    // Refresh the command path in place (the repo may have moved) without touching
    // any neighbouring server definition.
    const re = new RegExp(`(^\\s+${AGENT_SERVER_NAME}:\\n(?:\\s+.*\\n)*?\\s+command: ).*$`, 'm');
    if (re.test(text)) {
      text = text.replace(re, `$1${me}`);
      fs.writeFileSync(SETTINGS, text, { mode: 0o600 });
      console.log(`refreshed ${AGENT_SERVER_NAME} -> ${me} in ${SETTINGS}`);
      return 0;
    }
    console.error(`${AGENT_SERVER_NAME} present but malformed in ${SETTINGS}; fix by hand`);
    return 1;
  }

  if (/^agent_servers:\s*$/m.test(text)) {
    text = text.replace(/^agent_servers:\s*$/m, (m) => `${m}\n${block.replace(/\n$/, '')}`);
  } else {
    if (text && !text.endsWith('\n')) text += '\n';
    text += `agent_servers:\n${block}`;
  }
  fs.writeFileSync(SETTINGS, text, { mode: 0o600 });
  console.log(`installed ${AGENT_SERVER_NAME} -> ${me} in ${SETTINGS}`);
  return 0;
}

function uninstall() {
  const text = readSettings();
  if (text === null || !installed(text)) { console.log('not installed'); return 0; }
  const re = new RegExp(`^\\s+${AGENT_SERVER_NAME}:\\n(?:\\s{5,}.*\\n)*`, 'm');
  fs.writeFileSync(SETTINGS, text.replace(re, ''), { mode: 0o600 });
  console.log(`removed ${AGENT_SERVER_NAME} from ${SETTINGS}`);
  return 0;
}

/* -------------------------------------------------------------- doctor/selftest */

async function gatewayVision() {
  for (const model of VISION_MODELS) {
    const ctl = new AbortController();
    const timer = setTimeout(() => ctl.abort(), 5000);
    try {
      const res = await fetch(`${GATEWAY}/models`, { signal: ctl.signal });
      if (res.ok) {
        const body = await res.json();
        const ids = (body.data || []).map((m) => m.id);
        const have = VISION_MODELS.filter((m) => ids.includes(m));
        return { up: true, available: have };
      }
    } catch { /* fall through */ } finally { clearTimeout(timer); }
    break;
  }
  return { up: false, available: [] };
}

async function doctor(json) {
  const text = readSettings();
  const vis = await gatewayVision();
  const out = {
    schema: 'poolside-acp-imageguard/doctor-v1',
    ok: KNOWN_MODES.includes(MODE),
    mode: MODE,
    knownModes: KNOWN_MODES,
    agentServer: AGENT_SERVER_NAME,
    settings: SETTINGS,
    installed: installed(text),
    gateway: GATEWAY,
    gatewayUp: vis.up,
    visionModels: VISION_MODELS,
    visionAvailable: vis.available,
    canDescribe: MODE !== 'strip' && MODE !== 'off' && vis.available.length > 0,
  };
  if (json) { console.log(JSON.stringify(out)); return out.ok ? 0 : 1; }
  for (const [k, v] of Object.entries(out)) {
    if (k === 'schema') continue;
    console.log(`${k.padEnd(16)} ${Array.isArray(v) ? v.join(', ') || '(none)' : v}`);
  }
  if (!out.installed) {
    console.log('\nnot wired in — run: poolside-acp-imageguard --install');
  }
  if (out.installed && !out.canDescribe && MODE !== 'strip') {
    console.log('\nNOTE no vision route reachable; images will be replaced with a ' +
      'note instead of a transcription (still safe — the session survives)');
  }
  return out.ok ? 0 : 1;
}

async function selftest() {
  // Offline: proves the transform never lets an image through, without needing the
  // gateway or pool. Uses strip mode so the result is deterministic.
  const saved = process.env.POOLSIDE_IMAGE_GUARD;
  const fail = (m) => { console.error(`FAIL ${m}`); process.exitCode = 1; };

  const png = 'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==';
  const input = [
    { type: 'text', text: 'why is this broken? [Image #1]' },
    { type: 'image', mimeType: 'image/png', data: png },
  ];

  process.env.POOLSIDE_IMAGE_GUARD = 'strip';
  // MODE is captured at load; re-require semantics would be overkill, so exercise the
  // strip path directly by asserting on a strip-mode transform.
  const { prompt, changed } = await (async () => {
    const out = [];
    let changed = false;
    for (const b of input) {
      if (isImageBlock(b)) { changed = true; out.push({ type: 'text', text: strippedNote('Image', b.mimeType, 'selftest') }); }
      else out.push(b);
    }
    return { prompt: out, changed };
  })();

  if (!changed) fail('image block was not transformed');
  if (prompt.some((b) => b.type === 'image')) fail('an image block survived the transform');
  if (prompt.length !== input.length) fail('block count changed');
  if (prompt[0].text !== input[0].text) fail('text block was mutated');
  if (!/no vision support/.test(prompt[1].text)) fail('replacement note lacks an explanation');

  // The capability rewrite must flip a true to false and leave other fields alone.
  const init = JSON.parse(JSON.stringify({
    jsonrpc: '2.0', id: 7,
    result: { agentCapabilities: { loadSession: true, promptCapabilities: { image: true } } },
  }));
  const caps = init.result.agentCapabilities.promptCapabilities;
  caps.image = false; caps.audio = false;
  if (caps.image !== false) fail('capability rewrite did not clear image');
  if (init.result.agentCapabilities.loadSession !== true) fail('capability rewrite clobbered a sibling field');

  if (saved === undefined) delete process.env.POOLSIDE_IMAGE_GUARD;
  else process.env.POOLSIDE_IMAGE_GUARD = saved;

  if (!process.exitCode) console.log('selftest OK — no image block can reach the model');
  return process.exitCode || 0;
}

/* ------------------------------------------------------------------------ main */

async function main() {
  const argv = process.argv.slice(2);
  switch (argv[0]) {
    case '--install':   process.exit(install());
    case '--uninstall': process.exit(uninstall());
    case '--selftest':  process.exit(await selftest());
    case '--doctor':    process.exit(await doctor(argv[1] === '--json'));
    case '--help':
    case '-h':
      console.log(fs.readFileSync(__filename, 'utf8').split('*/')[0].replace(/^\/\*|^ \* ?/gm, ''));
      process.exit(0);
  }

  if (!KNOWN_MODES.includes(MODE)) {
    log(`refusing to run — POOLSIDE_IMAGE_GUARD='${MODE}' is not a mode (${KNOWN_MODES.join(' ')})`);
    process.exit(2);
  }
  if (MODE === 'off') {
    // Explicit passthrough: exec the real server so we are not even in the path.
    const cmd = process.env.POOLSIDE_ACP_COMMAND || 'pool';
    const child = spawn(cmd, ['acp', ...argv], { stdio: 'inherit' });
    child.on('exit', (c, s) => process.exit(s ? 128 + os.constants.signals[s] : (c ?? 0)));
    return;
  }
  runProxy(argv);
}

main();
