#!/usr/bin/env bash
# poolside-yolo - run the official Poolside `pool` coding-agent CLI fully autonomous.
# Mirrors the repo's other vendor -yolo wrappers (opencode-yolo, kimi-yolo): it
# wraps the OFFICIAL pool binary, never bundles or forks it.
#
#   poolside-yolo "build me X"      autonomous one-shot task (pool exec, auto-allow)
#   poolside-yolo                   autonomous interactive TUI (--mode always-allow)
#   poolside-yolo login             passthrough to real Poolside/OpenRouter login
#                                    (gateway env vars withheld so auth isn't shadowed)
#   poolside-yolo --doctor[/--json] health (lane, binary, version, gateway, model, mode)
#
# LANES (POOLSIDE_YOLO_LANE=auto|native|gateway|local, default auto)
#   native   Poolside's OWN inference (inference.poolside.ai) using the credentials
#            `pool login` stored. Laguna S 2.1, 1M ctx, coding-specialised, and — this
#            is the point — a SEPARATE quota pool from z.ai and OpenRouter.
#   gateway  The Hermes LiteLLM gateway (:4010) via Poolside's documented
#            "custom OpenAI-compatible endpoint" env vars (POOLSIDE_STANDALONE_BASE_URL /
#            POOLSIDE_STANDALONE_MODEL / POOLSIDE_API_KEY), inheriting the fleet's
#            fallback chain (glm-coding -> opencode-go-glm -> nemotron3-free ->
#            laguna-free -> opencode-free -> local).
#   local    Ollama, >=8B, tool-capable. The zero-spend route.
#
# Why `auto` prefers NATIVE over the gateway (changed 2026-07-28):
#   This wrapper used to force EVERY run through the gateway. That is only a win while
#   the gateway's chain is healthy — and it shares one failure domain with the whole
#   fleet. On 2026-07-28 every cloud route in the chain was down at the same time:
#   z.ai's weekly cap blew (glm-coding/glm-47 both timing out, reset 2026-08-01),
#   OpenRouter hit free-models-per-day (nemotron3-free 429, laguna-free 408),
#   opencode-go-glm/opencode-free 429, Moonshot suspended for balance. Asking the
#   gateway for glm-coding then took ~40s to walk the dead chain and silently answered
#   with local qwen3:8b — or blew past pool's own ACP deadline first and surfaced as
#   "429 ... No deployments available for selected model" mid-session. Either way
#   poolside-yolo looked broken, while Igor's own Poolside subscription sat unused with
#   its independent quota intact. Native-first removes that shared failure domain;
#   the gateway chain is still one `POOLSIDE_YOLO_LANE=gateway` away.
#
# Autonomy contract — poolside-yolo must NEVER stop to ask for permission:
#   * TUI  -> --mode always-allow  ("Allow all": approves every tool call, no prompts)
#   * exec -> --unsafe-auto-allow  (same, for non-interactive runs)
#
# Why the mode ID is verified, not assumed:
#   pool's --mode flag SILENTLY falls back to the default ("Always ask") mode when
#   handed an ID the agent server doesn't advertise — it only prints
#   `Mode "x" was not found, using the default mode.` and then prompts for every
#   tool. This wrapper shipped `allow-all` (a plausible guess that is NOT a real
#   mode) and was therefore fully interactive while claiming to be autonomous. The
#   real IDs, confirmed live from the pool ACP server and docs.poolside.ai, are:
#     default | accept-edits | plan | always-allow
#   So: unknown modes fail loudly here (exit 2) instead of silently degrading, and
#   `--doctor` probes the live ACP server to catch a future rename.
#
# Safety:
#   * Honors the fleet zero-spend gate (~/.hermes/NO_PAID_SPEND). That marker's policy
#     is "no-paid-provider-or-metered-token-execution", so instead of refusing to run
#     at all we route to LOCAL Ollama (>=8B, tool-capable) — free and unmetered — and
#     say so on stderr. Only if no usable local model exists do we exit 73. Set
#     POOLSIDE_YOLO_ZERO_SPEND_STRICT=1 to restore the old refuse-outright behaviour.
#     This is what makes poolside-yolo usable on the mini, where the gate unloads the
#     litellm gateway entirely.
#   * Install: curl -fsSL https://downloads.poolside.ai/pool/install.sh | sh
set -euo pipefail

GATEWAY_URL="${POOLSIDE_YOLO_GATEWAY_URL:-http://127.0.0.1:4010/v1}"
DEFAULT_MODEL="${POOLSIDE_YOLO_MODEL:-glm-coding}"
MARKER="${HERMES_ZERO_SPEND_MARKER:-$HOME/.hermes/NO_PAID_SPEND}"

# Which inference lane to use. `auto` resolves at run time (see select_lane).
LANE="${POOLSIDE_YOLO_LANE:-auto}"
KNOWN_LANES="auto native gateway local"

# The "never ask me for permission" mode. Overridable, but it must still be a mode
# the agent server really advertises.
YOLO_MODE="${POOLSIDE_YOLO_MODE:-always-allow}"
# Modes shipped by pool v1.0.14 (docs.poolside.ai/cli/interactive-mode + live probe).
KNOWN_MODES="default accept-edits plan always-allow"

# Zero-spend local route. The fleet marker's own policy string is
# "no-paid-provider-or-metered-token-execution" — local Ollama is neither paid nor
# metered, and the T-320 gate that writes the marker already pins the fleet to local
# qwen. So under zero-spend we run LOCALLY instead of refusing to run at all; that is
# what makes this usable on the mini, whose litellm gateway the gate unloads.
LOCAL_URL="${POOLSIDE_YOLO_LOCAL_URL:-http://127.0.0.1:11434/v1}"
# Ordered preference, all >= 8B — never silently drop to a 3B that cannot tool-call.
# qwen3.5:9b-hermes-64k is first because it is the one verified end-to-end driving
# pool's tools (wrote a file via tool call on the mini, 2026-07-27).
LOCAL_MODEL_PREFS="qwen3.5:9b-hermes-64k qwen3:8b-agent-64k qwen3:8b-hermes-20k qwen3.5:9b qwen3:8b-64k qwen3:8b"

# Accept the names people (and our own older docs) reach for, map them to the real
# IDs. `allow-all` is the exact string this wrapper used to pass, so it must keep
# working rather than becoming a hard error for anyone with it in muscle memory.
normalize_mode() {
  case "$1" in
    allow-all|allow_all|allowall|yolo|auto|always_allow) printf 'always-allow\n' ;;
    accept_edits|edits|accept)                           printf 'accept-edits\n' ;;
    ask|always-ask|always_ask|prompt)                    printf 'default\n' ;;
    *)                                                   printf '%s\n' "$1" ;;
  esac
}

mode_known() {
  local m
  for m in $KNOWN_MODES; do [[ "$m" == "$1" ]] && return 0; done
  return 1
}

resolve_pool() {
  local candidate=""
  if [[ -n "${POOL_BIN:-}" ]]; then
    [[ -x "$POOL_BIN" ]] && { printf '%s\n' "$POOL_BIN"; return 0; }
    return 1
  fi
  for candidate in "$HOME/.local/bin/pool" "$(command -v pool 2>/dev/null || true)"; do
    [[ -n "$candidate" && -x "$candidate" ]] && { printf '%s\n' "$candidate"; return 0; }
  done
  return 1
}

emit_missing() {
  if [[ "${1:-}" == json ]]; then
    printf '%s\n' '{"schema":"poolside-yolo/doctor-v1","ok":false,"error":"official pool binary not found"}'
  else
    echo "poolside-yolo: official 'pool' binary not found (install: curl -fsSL https://downloads.poolside.ai/pool/install.sh | sh)" >&2
  fi
}

gateway_up() { curl -fsS -m 4 "${GATEWAY_URL%/v1}/health/liveliness" >/dev/null 2>&1; }

local_up() { curl -fsS -m 4 "${LOCAL_URL%/}/models" >/dev/null 2>&1; }

# Where `pool login` stores its credentials. `pool config` prints the authoritative
# path ("credentials file: ..."), so ask the binary rather than hardcoding a layout
# that a future pool release could move. Env override exists so the hermetic tests
# (and anyone with a non-standard XDG setup) can point this somewhere deterministic.
resolve_creds() {
  local bin="$1" line
  if [[ -n "${POOLSIDE_YOLO_CREDENTIALS:-}" ]]; then printf '%s\n' "$POOLSIDE_YOLO_CREDENTIALS"; return 0; fi
  line="$("$bin" config 2>/dev/null | sed -n 's/^[[:space:]]*credentials file:[[:space:]]*//p' | head -n1)"
  [[ -n "$line" ]] && { printf '%s\n' "$line"; return 0; }
  printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/poolside/credentials.json"
}

# Is a native lane configured? Two ways, and BOTH count:
#   1. a non-empty credentials file, written by `pool login`
#   2. an inherited POOLSIDE_API_KEY — docs.poolside.ai: "For automation environments,
#      set POOLSIDE_API_KEY instead of using stored credentials. pool checks it before
#      reading from configuration files." It is Poolside's OWN auth variable and takes
#      PRECEDENCE over the file, so ignoring it had two bad consequences: `auto` fell
#      through to the gateway and then re-used the caller's real Poolside key as the
#      gateway bearer token, and an explicit lane=native exited 69 while perfectly
#      valid credentials sat in the environment.
# The placeholder this script itself hands the gateway is not native auth, so it must
# not count — otherwise a re-entrant call would see its own bearer token as a login.
#
# This is a cheap local check on purpose: it says "a native lane is configured", not
# "the token is still valid". A stale token surfaces as a pool auth error, which is
# loud and actionable — unlike the gateway's silent downgrade to a weaker model.
GATEWAY_PLACEHOLDER_KEY="hermes-local-gateway"
native_authed() {
  [[ -s "$1" ]] && return 0
  [[ -n "${POOLSIDE_API_KEY:-}" && "${POOLSIDE_API_KEY:-}" != "$GATEWAY_PLACEHOLDER_KEY" ]]
}

# Resolve LANE=auto to a concrete lane. Order is deliberate:
#   1. zero-spend marker wins over everything (unchanged policy: no paid/metered calls)
#   2. native  — free, independent quota, no shared failure domain with the fleet
#   3. gateway — the fleet chain, when native was never logged in
#
# `local` is deliberately NOT an automatic fallback here. It is reachable only via the
# zero-spend marker or an explicit POOLSIDE_YOLO_LANE=local, because quietly demoting a
# run to an 8B local model is the same silent-degradation failure this change exists to
# remove: the user asked for a coding agent and would get a much weaker one with no
# error anywhere. A down gateway with no native login stays a loud exit 69.
#
# The zero-spend marker is applied HERE rather than only on the execution path, so
# `--doctor` reports the lane a run would really take. When the override lived only in
# the runtime branch, doctor answered `lane=native` (and probed it) while execution
# forced `local` — misleading diagnostics precisely during policy enforcement, which is
# the exact failure class this wrapper exists to eliminate.
select_lane() {
  local creds="$1" want="$LANE"
  if [[ "$want" == auto ]]; then
    if native_authed "$creds"; then want=native; else want=gateway; fi
  fi
  if [[ -e "$MARKER" && "$want" != "local" ]]; then printf 'local\n'; return 0; fi
  printf '%s\n' "$want"
}

lane_known() {
  local l
  for l in $KNOWN_LANES; do [[ "$l" == "$1" ]] && return 0; done
  return 1
}

# First preferred local model the local endpoint actually serves. Prints nothing when
# none of them are present — the caller must then refuse rather than guess.
pick_local_model() {
  local list cand
  if [[ -n "${POOLSIDE_YOLO_LOCAL_MODEL:-}" ]]; then printf '%s\n' "$POOLSIDE_YOLO_LOCAL_MODEL"; return 0; fi
  list="$(curl -fsS -m 4 "${LOCAL_URL%/}/models" 2>/dev/null)" || return 1
  for cand in $LOCAL_MODEL_PREFS; do
    printf '%s' "$list" | grep -q "\"id\"[[:space:]]*:[[:space:]]*\"$cand\"" && { printf '%s\n' "$cand"; return 0; }
  done
  return 1
}

# Ask the installed pool ACP server which session modes it actually advertises
# (ACP: initialize -> session/new -> result.modes.availableModes). Prints the IDs
# space-separated. Non-zero/empty when it can't be determined; callers must treat
# "unknown" as unknown, never as "valid".
# $2 is the lane the probe should emulate: on the native lane pool must talk to
# Poolside's own inference with its stored credentials, so the standalone override
# vars are withheld rather than pointed at the gateway.
probe_modes() {
  local bin="$1" lane="${2:-gateway}"
  command -v node >/dev/null 2>&1 || return 1
  POOL_PROBE_BIN="$bin" \
  POOL_PROBE_LANE="$lane" \
  POOL_PROBE_BASE="$GATEWAY_URL" \
  POOL_PROBE_KEY="${POOLSIDE_API_KEY:-hermes-local-gateway}" \
  POOL_PROBE_MODEL="$DEFAULT_MODEL" \
  node -e '
    const {spawn} = require("child_process");
    const env = Object.assign({}, process.env);
    if (process.env.POOL_PROBE_LANE === "native") {
      delete env.POOLSIDE_STANDALONE_BASE_URL;
      delete env.POOLSIDE_STANDALONE_MODEL;
      delete env.POOLSIDE_API_KEY;
    } else Object.assign(env, {
      POOLSIDE_STANDALONE_BASE_URL: process.env.POOL_PROBE_BASE,
      POOLSIDE_API_KEY: process.env.POOL_PROBE_KEY,
      POOLSIDE_STANDALONE_MODEL: process.env.POOL_PROBE_MODEL,
    });
    const p = spawn(process.env.POOL_PROBE_BIN, ["acp"], {env, stdio:["pipe","pipe","ignore"]});
    let buf = "", done = false;
    const bail = c => { if (!done) { done = true; try { p.kill(); } catch (e) {} process.exit(c); } };
    p.on("error", () => bail(1));
    p.stdout.on("data", d => {
      buf += d.toString();
      let i;
      while ((i = buf.indexOf("\n")) >= 0) {
        const line = buf.slice(0, i); buf = buf.slice(i + 1);
        if (!line.trim()) continue;
        let msg; try { msg = JSON.parse(line); } catch (e) { continue; }
        if (msg.id !== 2) continue;
        const modes = msg.result && msg.result.modes && msg.result.modes.availableModes;
        if (!Array.isArray(modes) || !modes.length) bail(1);
        process.stdout.write(modes.map(m => m.id).join(" ") + "\n");
        bail(0);
      }
    });
    const send = o => p.stdin.write(JSON.stringify(o) + "\n");
    send({jsonrpc:"2.0", id:1, method:"initialize",
          params:{protocolVersion:1, clientCapabilities:{fs:{readTextFile:true, writeTextFile:true}}}});
    setTimeout(() => send({jsonrpc:"2.0", id:2, method:"session/new",
          params:{cwd:process.cwd(), mcpServers:[]}}), 1200);
    setTimeout(() => bail(1), 12000);
  ' 2>/dev/null
}

# Is DEFAULT_MODEL actually served by the gateway right now? A missing model is the
# other way this stack degrades quietly (gateway falls back to whatever it has).
model_served() {
  local list
  list="$(curl -fsS -m 4 "${GATEWAY_URL%/}/models" 2>/dev/null)" || return 1
  printf '%s' "$list" | grep -q "\"id\"[[:space:]]*:[[:space:]]*\"$DEFAULT_MODEL\""
}

# Which model does the gateway ACTUALLY answer with? `model_served` only proves the
# ID is listed — the gateway's fallback chain (glm-coding -> opencode-go-glm ->
# nemotron3-free -> ...) can quietly serve something else entirely when the primary
# route is out of quota, and the agent just gets dumber with no error anywhere.
# Costs one 1-token completion, so it is doctor-only, and never runs under the
# zero-spend gate (that marker means "make no paid model calls").
#
# The timeout must exceed the gateway's own per-route timeout (45s in the fleet
# config), or this probe times out first and reports "unknown" — which is exactly how
# a fully-dead chain read as healthy on 2026-07-28: doctor said ok=true, modelServing
# =null, while a real call took ~40s and came back as local qwen3:8b.
model_serving() {
  [[ -e "$MARKER" ]] && return 1
  [[ -n "${POOLSIDE_YOLO_DOCTOR_NO_PROBE:-}" ]] && return 1
  curl -fsS -m "${POOLSIDE_YOLO_PROBE_TIMEOUT:-55}" "${GATEWAY_URL%/}/chat/completions" \
    -H "Authorization: Bearer ${POOLSIDE_API_KEY:-hermes-local-gateway}" \
    -H "Content-Type: application/json" \
    -d "{\"model\":\"$DEFAULT_MODEL\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"max_tokens\":1}" \
    2>/dev/null | sed -n 's/.*"model"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1
}

doctor() {
  local format="${1:-text}" bin="" version="" up="false"
  local modes="" mode_valid="unknown" model_ok="unknown" serving="" fellback="unknown"
  local local_ok="false" local_model=""
  local creds="" native_ok="false" lane=""
  if ! bin="$(resolve_pool)"; then emit_missing "$format"; return 127; fi
  version="$("$bin" --version 2>/dev/null | head -n1 || true)"
  gateway_up && up="true"
  creds="$(resolve_creds "$bin")"
  native_authed "$creds" && native_ok="true"
  lane="$(select_lane "$creds")"
  # Under zero-spend this is the route that actually runs, so report it.
  if local_up; then local_ok="true"; local_model="$(pick_local_model || true)"; fi
  # Only probe the gateway's real behaviour when the gateway is the lane we would
  # actually take — otherwise the probe spends ~40s (and a model call) proving
  # something about a route this run will not use.
  if [[ "$up" == "true" && "$lane" == "gateway" ]]; then
    model_served && model_ok="true" || model_ok="false"
    serving="$(model_serving || true)"
    if [[ -n "$serving" ]]; then
      [[ "$serving" == "$DEFAULT_MODEL" ]] && fellback="false" || fellback="true"
    fi
  elif [[ "$up" == "true" ]]; then
    model_served && model_ok="true" || model_ok="false"
  fi
  if [[ "$up" == "true" || "$native_ok" == "true" ]]; then
    if modes="$(probe_modes "$bin" "$lane")" && [[ -n "$modes" ]]; then
      mode_valid="false"
      for m in $modes; do [[ "$m" == "$YOLO_MODE" ]] && mode_valid="true"; done
    fi
  fi
  if [[ "$format" == json ]]; then
    PYB="$bin" PYV="$version" PYG="$GATEWAY_URL" PYM="$DEFAULT_MODEL" PYUP="$up" \
    PYMODE="$YOLO_MODE" PYMODES="$modes" PYMV="$mode_valid" PYMOK="$model_ok" \
    PYSERV="$serving" PYFB="$fellback" PYLOK="$local_ok" PYLM="$local_model" \
    PYLANE="$lane" PYLANEREQ="$LANE" PYNAT="$native_ok" PYCRED="$creds" \
    PYZ="$([[ -e "$MARKER" ]] && echo true || echo false)" node -e '
      const tri = v => v === "true" ? true : v === "false" ? false : null;
      process.stdout.write(JSON.stringify({
        schema:"poolside-yolo/doctor-v1", ok:true, provider:"Poolside pool CLI (official)",
        binary:process.env.PYB, version:process.env.PYV,
        lane:process.env.PYLANE, laneRequested:process.env.PYLANEREQ,
        nativeAuthed:process.env.PYNAT==="true", credentialsFile:process.env.PYCRED,
        gateway:process.env.PYG, gatewayUp:process.env.PYUP==="true",
        defaultModel:process.env.PYM, modelServed:tri(process.env.PYMOK),
        modelServing:process.env.PYSERV || null, modelFellBack:tri(process.env.PYFB),
        localUp:process.env.PYLOK==="true", localModel:process.env.PYLM || null,
        mode:process.env.PYMODE, modeValid:tri(process.env.PYMV),
        availableModes:process.env.PYMODES ? process.env.PYMODES.split(" ") : [],
        zeroSpendActive:process.env.PYZ==="true",
        autonomous:true
      })+"\n");' 2>/dev/null || python3 -c '
import json, os
def tri(v):
    return True if v == "true" else False if v == "false" else None
print(json.dumps({
  "schema": "poolside-yolo/doctor-v1", "ok": True, "provider": "Poolside pool CLI (official)",
  "binary": os.environ["PYB"], "version": os.environ["PYV"],
  "lane": os.environ["PYLANE"], "laneRequested": os.environ["PYLANEREQ"],
  "nativeAuthed": os.environ["PYNAT"] == "true", "credentialsFile": os.environ["PYCRED"],
  "gateway": os.environ["PYG"], "gatewayUp": os.environ["PYUP"] == "true",
  "defaultModel": os.environ["PYM"], "modelServed": tri(os.environ["PYMOK"]),
  "modelServing": os.environ["PYSERV"] or None, "modelFellBack": tri(os.environ["PYFB"]),
  "localUp": os.environ["PYLOK"] == "true", "localModel": os.environ["PYLM"] or None,
  "mode": os.environ["PYMODE"], "modeValid": tri(os.environ["PYMV"]),
  "availableModes": os.environ["PYMODES"].split() if os.environ["PYMODES"] else [],
  "zeroSpendActive": os.environ["PYZ"] == "true",
  "autonomous": True,
}))'
  else
    printf 'POOLSIDE_YOLO_OK binary=%s version=%s lane=%s native_authed=%s gateway=%s up=%s model=%s model_served=%s serving=%s local=%s mode=%s mode_valid=%s zero_spend=%s\n' \
      "$bin" "$version" "$lane" "$native_ok" "$GATEWAY_URL" "$up" "$DEFAULT_MODEL" "$model_ok" "${serving:-unknown}" "${local_model:-none}" "$YOLO_MODE" "$mode_valid" \
      "$([[ -e "$MARKER" ]] && echo true || echo false)"
    [[ "$mode_valid" == "false" ]] && \
      echo "poolside-yolo: WARNING mode '$YOLO_MODE' is not advertised by this pool build (available: $modes) — it would silently fall back to approval prompts" >&2
    [[ "$fellback" == "true" ]] && \
      echo "poolside-yolo: WARNING gateway answers '$DEFAULT_MODEL' with '$serving' — the primary route is down and you are talking to a fallback model" >&2
    [[ "$lane" == "gateway" && "$native_ok" == "false" ]] && \
      echo "poolside-yolo: NOTE no Poolside credentials at $creds — run 'poolside-yolo login' to unlock the native lane (separate quota from z.ai/OpenRouter)" >&2
  fi
  return 0
}

if [[ "${1:-}" == "--doctor" ]]; then
  shift
  case "${1:-}" in
    "") doctor text ;;
    --json) shift; [[ $# -eq 0 ]] || { echo "poolside-yolo: --doctor --json takes no more args" >&2; exit 2; }; doctor json ;;
    *) echo "poolside-yolo: --doctor accepts only optional --json" >&2; exit 2 ;;
  esac
  exit $?
fi

if ! PBIN="$(resolve_pool)"; then emit_missing text; exit 127; fi

# `login`/`update`/version/help are vendor-account or metadata operations — never
# withhold real auth behind our gateway shim, and don't gate them on the fleet's
# zero-spend marker (they make no model calls of their own).
case "${1:-}" in
  login|update|--version|-v|--help|-h)
    exec "$PBIN" "$@" ;;
esac

if ! lane_known "$LANE"; then
  echo "poolside-yolo: refusing to run — POOLSIDE_YOLO_LANE='$LANE' is not a lane ($KNOWN_LANES)" >&2
  exit 2
fi

CREDS="$(resolve_creds "$PBIN")"
RESOLVED_LANE="$(select_lane "$CREDS")"

# The zero-spend marker is policy, not a preference: it outranks an explicit lane
# request for every lane that would make a paid or metered call. select_lane already
# applied it (so --doctor agrees with runtime); this only reports the demotion, which
# would otherwise be invisible to someone who explicitly asked for a paid lane.
if [[ -e "$MARKER" && "$LANE" != auto && "$LANE" != local ]]; then
  echo "poolside-yolo: fleet zero-spend is active ($MARKER) — ignoring requested lane '$LANE' and running locally" >&2
fi

case "$RESOLVED_LANE" in
  local)
    # Strict mode keeps the old refuse-outright behaviour for anyone who wants it.
    if [[ -e "$MARKER" && -n "${POOLSIDE_YOLO_ZERO_SPEND_STRICT:-}" ]]; then
      echo "poolside-yolo: blocked — fleet zero-spend is active ($MARKER) and POOLSIDE_YOLO_ZERO_SPEND_STRICT is set" >&2
      exit 73
    fi
    if ! local_up; then
      echo "poolside-yolo: blocked — local lane selected and no local model endpoint at ${LOCAL_URL%/v1}" >&2
      echo "poolside-yolo: start Ollama (or set POOLSIDE_YOLO_LOCAL_URL) to run locally at zero cost" >&2
      exit 73
    fi
    if ! LOCAL_MODEL="$(pick_local_model)"; then
      echo "poolside-yolo: blocked — local lane selected and ${LOCAL_URL%/} serves none of: $LOCAL_MODEL_PREFS" >&2
      echo "poolside-yolo: pull one (e.g. ollama pull qwen3.5:9b) or set POOLSIDE_YOLO_LOCAL_MODEL" >&2
      exit 73
    fi
    echo "poolside-yolo: lane=local — running on $LOCAL_MODEL via ${LOCAL_URL%/} (no paid or metered tokens)" >&2
    export POOLSIDE_STANDALONE_BASE_URL="$LOCAL_URL"
    export POOLSIDE_API_KEY="${POOLSIDE_API_KEY:-ollama}"
    export POOLSIDE_STANDALONE_MODEL="$LOCAL_MODEL"
    ;;
  native)
    if ! native_authed "$CREDS"; then
      echo "poolside-yolo: blocked — lane=native but no Poolside credentials at $CREDS" >&2
      echo "poolside-yolo: run 'poolside-yolo login', or use POOLSIDE_YOLO_LANE=gateway" >&2
      exit 69
    fi
    # Withhold the standalone overrides so pool talks to Poolside's own inference.
    # Unsetting (not just skipping) matters: an exported POOLSIDE_STANDALONE_BASE_URL
    # left over in the caller's shell would silently drag this run back onto the gateway.
    unset POOLSIDE_STANDALONE_BASE_URL POOLSIDE_STANDALONE_MODEL
    # POOLSIDE_API_KEY is Poolside's OWN auth var and outranks the credentials file, so
    # a caller-supplied one is native auth and must SURVIVE — clearing it broke the
    # documented automation flow. Only our own gateway placeholder is cleared, since
    # that is a bearer token for a different endpoint, not a Poolside credential.
    [[ "${POOLSIDE_API_KEY:-}" == "$GATEWAY_PLACEHOLDER_KEY" ]] && unset POOLSIDE_API_KEY
    echo "poolside-yolo: lane=native — Poolside inference (own quota, independent of z.ai/OpenRouter)" >&2
    ;;
  gateway)
    if ! gateway_up; then
      echo "poolside-yolo: Hermes gateway not reachable at ${GATEWAY_URL%/v1} — start com.igor.hermes-litellm first" >&2
      exit 69
    fi
    # Route pool's "custom OpenAI-compatible endpoint" support at the Hermes gateway
    # instead of Poolside's own cloud/OpenRouter billing.
    #
    # The bearer deliberately does NOT fall back to POOLSIDE_API_KEY. That variable is a
    # Poolside PLATFORM credential; forwarding it to a different endpoint just because
    # it happens to be exported would hand a real vendor key to the gateway. Use an
    # explicit POOLSIDE_YOLO_GATEWAY_KEY when the gateway needs a genuine token.
    export POOLSIDE_STANDALONE_BASE_URL="$GATEWAY_URL"
    export POOLSIDE_API_KEY="${POOLSIDE_YOLO_GATEWAY_KEY:-$GATEWAY_PLACEHOLDER_KEY}"
    export POOLSIDE_STANDALONE_MODEL="$DEFAULT_MODEL"
    ;;
esac

YOLO_MODE="$(normalize_mode "$YOLO_MODE")"
if ! mode_known "$YOLO_MODE"; then
  echo "poolside-yolo: refusing to run — mode '$YOLO_MODE' is not a pool session mode ($KNOWN_MODES)." >&2
  echo "poolside-yolo: pool would silently fall back to approval prompts instead of running autonomously." >&2
  exit 2
fi

# Human at a terminal wants readable output; a pipe/cron wants parseable NLJSON.
oneshot_output() { [[ -t 1 ]] && printf 'markdown\n' || printf 'json\n'; }

if [[ $# -eq 0 ]]; then
  exec "$PBIN" --mode "$YOLO_MODE"
fi

case "$1" in
  exec)
    shift
    has_allow=0; has_out=0
    for a in "$@"; do case "$a" in --unsafe-auto-allow) has_allow=1;; -o|-o=*|--output|--output=*) has_out=1;; esac; done
    extra=()
    ((has_allow)) || extra+=(--unsafe-auto-allow)
    ((has_out)) || extra+=(-o "$(oneshot_output)")
    exec "$PBIN" exec "${extra[@]}" "$@" ;;
  -*)
    # An explicit --mode wins, but normalize/validate it so a typo can't quietly
    # drop the session back into "Always ask".
    args=(); has_mode=0; want_mode=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --mode)   has_mode=1; want_mode="$(normalize_mode "${2:-}")"; args+=(--mode "$want_mode"); shift 2 || shift ;;
        --mode=*) has_mode=1; want_mode="$(normalize_mode "${1#--mode=}")"; args+=(--mode "$want_mode"); shift ;;
        *)        args+=("$1"); shift ;;
      esac
    done
    if ((has_mode)); then
      if ! mode_known "$want_mode"; then
        echo "poolside-yolo: '--mode $want_mode' is not a pool session mode ($KNOWN_MODES); pool would silently fall back to approval prompts" >&2
        exit 2
      fi
      exec "$PBIN" "${args[@]}"
    else
      exec "$PBIN" --mode "$YOLO_MODE" "${args[@]}"
    fi ;;
  *)
    # Bare task string -> autonomous one-shot, mirroring kimi-yolo's routing.
    exec "$PBIN" exec -p "$*" --unsafe-auto-allow -o "$(oneshot_output)" ;;
esac
