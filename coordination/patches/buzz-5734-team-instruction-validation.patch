+/// `validate_inbound_managed_agent_definition` above so a hostile or
+/// corrupted kind:30176 event can no longer land unvalidated instructions in
+/// the local store via relay sync.
+fn validate_inbound_team_definition(team: &TeamEventContent) -> Result<(), String> {
+    // `instructions: None` means "publisher predates always-publish" (see
+    // `TeamEventContent` doc comment) and carries no text to validate;
+    // `Some(None)` is an explicit clear, also nothing to validate.
+    let instructions = team.instructions.clone().flatten();
+    crate::managed_agents::validate_team_definition_text(&team.name, instructions.as_deref())
+        .map_err(|error| format!("Inbound team definition is unsafe: {error}"))
+}
